{
  "name": "calendar-ics-snapshots",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:site": "vite --config vite.site.config.ts",
    "build": "npm run build:app && npm run build:site",
    "build:app": "vite build",
    "build:site": "vite build --config vite.site.config.ts",
    "serve:site": "node scripts/serve-static.mjs dist/site",
    "test": "vitest run",
    "test:claims": "node scripts/run-claims.mjs",
    "setup:native": "node scripts/setup-native-prerequisites.mjs",
    "claim:native-caldav-transport": "npm run setup:native && cargo test --manifest-path src-tauri/Cargo.toml native_caldav_transport",
    "test:e2e": "playwright test",
    "test:e2e:static": "playwright test --config playwright.static.config.ts",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@eslint/js": "^9.39.3",
    "@playwright/test": "1.58.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "22.12.0",
    "eslint": "^9.39.3",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.56.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
